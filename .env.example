# Alloc-X does not place credentials in source control.
# Empty security-sensitive values must be supplied only on the local machine.
ALLOC_X_ENV=local
ALLOC_X_LOCAL_XRPL_RPC_URL=http://127.0.0.1:5005
ALLOC_X_LOCAL_XRPL_TREASURY_ACCOUNT=
ALLOC_X_LOCAL_EXECUTOR_KEY_REF=
ALLOC_X_LOCAL_POLICY_KEY_REF=
ALLOC_X_LOCAL_DATABASE_URL=postgresql://alloc_x_local@127.0.0.1:5432/alloc_x_local
ALLOC_X_LOCAL_OBJECT_STORE_URL=file://./.local/object-store
