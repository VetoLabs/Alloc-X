{
  "name": "alloc-x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Policy-bound treasury allocation and payment infrastructure.",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "check": "node scripts/run-local-checks.mjs",
    "workspace:validate": "node scripts/quality/validate-workspace.mjs",
    "security:scan": "node scripts/security/scan-secrets.mjs",
    "format": "node scripts/quality/format-json.mjs",
    "format:check": "node scripts/quality/check-format.mjs",
    "lint": "node scripts/quality/lint.mjs",
    "test": "node --test --test-isolation=none packages/config/test/config.test.ts packages/contracts/test/contracts.test.ts packages/contracts/test/domain.test.ts packages/authorization/test/authorization.test.ts packages/policy-engine/test/policy-engine.test.ts packages/policy-engine/test/policy-boundaries.test.ts packages/audit-chain/test/audit-chain.test.ts packages/accounting/test/accounting.test.ts packages/payment-intents/test/payment-intents.test.ts packages/beneficiaries/test/beneficiaries.test.ts packages/beneficiaries/test/beneficiary-policy.integration.test.ts services/approval-layer/test/approval-layer.test.ts services/approval-layer/test/durable-decision-journal.test.ts services/xrpl-adapter/test/xrpl-adapter.test.ts services/signers/test/signers.test.ts tests/integration/environment-boundaries.test.ts tests/integration/security-boundary.test.ts",
    "test:unit": "node --test --test-isolation=none packages/config/test/config.test.ts packages/contracts/test/contracts.test.ts packages/contracts/test/domain.test.ts packages/authorization/test/authorization.test.ts packages/policy-engine/test/policy-engine.test.ts packages/policy-engine/test/policy-boundaries.test.ts packages/audit-chain/test/audit-chain.test.ts packages/accounting/test/accounting.test.ts packages/payment-intents/test/payment-intents.test.ts packages/beneficiaries/test/beneficiaries.test.ts packages/beneficiaries/test/beneficiary-policy.integration.test.ts services/approval-layer/test/approval-layer.test.ts services/approval-layer/test/durable-decision-journal.test.ts services/xrpl-adapter/test/xrpl-adapter.test.ts services/signers/test/signers.test.ts",
    "test:integration": "node --test --test-isolation=none tests/integration/environment-boundaries.test.ts tests/integration/security-boundary.test.ts",
    "test:contracts": "node --test --test-isolation=none packages/contracts/test/contracts.test.ts packages/contracts/test/domain.test.ts",
    "test:policy": "node --test --test-isolation=none packages/policy-engine/test/policy-engine.test.ts packages/policy-engine/test/policy-boundaries.test.ts",
    "test:audit": "node --test --test-isolation=none packages/audit-chain/test/audit-chain.test.ts",
    "test:accounting": "node --test --test-isolation=none packages/accounting/test/accounting.test.ts",
    "test:intents": "node --test --test-isolation=none packages/payment-intents/test/payment-intents.test.ts",
    "test:approval-layer": "node --test --test-isolation=none services/approval-layer/test/approval-layer.test.ts services/approval-layer/test/durable-decision-journal.test.ts",
    "test:beneficiaries": "node --test --test-isolation=none packages/beneficiaries/test/beneficiaries.test.ts packages/beneficiaries/test/beneficiary-policy.integration.test.ts",
    "test:xrpl-adapter": "node --test --test-isolation=none services/xrpl-adapter/test/xrpl-adapter.test.ts",
    "test:xrpl:integration": "node --use-system-ca --test --test-isolation=none services/xrpl-adapter/test/xrpl-adapter.integration.test.ts services/signers/test/signers.integration.test.ts",
    "test:signers": "node --test --test-isolation=none services/signers/test/signers.test.ts",
    "test:policy-simulator": "node --test --test-isolation=none services/policy-simulator/test/policy-simulator.test.ts",
    "test:security-controls": "node --test --test-isolation=none services/security-controls/test/security-controls.test.ts",
    "test:receipts": "node --test --test-isolation=none services/receipt-builder/test/receipt-builder.test.ts",
    "test:evidence": "node --test --test-isolation=none services/evidence-pipeline/test/evidence-pipeline.test.ts",
    "test:orchestrator": "node --test --test-isolation=none services/payment-orchestrator/test/payment-orchestrator.test.ts",
    "test:ledger-monitor": "node --test --test-isolation=none services/ledger-monitor/test/ledger-monitor.test.ts",
    "test:payment-path": "node --test --test-isolation=none services/payment-path/test/payment-path.test.ts",
    "test:policy-source": "node --test --test-isolation=none services/policy-source/test/policy-source.test.ts",
    "test:policy-registry": "node --test --test-isolation=none services/policy-registry/test/policy-registry.test.ts"
  }
}
